# samgple — variables de entorno
# Cópialo a .env.local para trabajar en local; en producción se ponen en Vercel → Settings → Environment Variables.

# ===========================================
# OBLIGATORIAS — Supabase (acceso y base de datos)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de la web (Stripe la usa para volver tras el pago; también los enlaces de los correos)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Cifra la clave de Stripe y la contraseña del correo guardadas en la base de datos.
# Generar con: openssl rand -base64 32   ·   AVISO: si la cambias, lo ya guardado deja de poder leerse.
ENCRYPTION_SECRET=your-32-byte-secret-here

# ===========================================
# Cobro de packs con Stripe (ver docs/STRIPE_PACKS.md)
# ===========================================
# La clave secreta se guarda desde Panel → Ajustes → Pagos y email → Stripe.
# Esta variable solo es un respaldo si prefieres no guardarla en el panel.
# STRIPE_PACKS_SECRET_KEY=sk_live_...
# Secreto de firma del webhook (Stripe → Desarrolladores → Webhooks): necesario para registrar compras
# aunque el cliente cierre la pestaña antes de volver a la web.
# STRIPE_PACKS_WEBHOOK_SECRET=whsec_...

# ===========================================
# Avisos por email (ver docs/EMAIL_RESEND.md)
# ===========================================
# RESEND_API_KEY=re_...
# RESEND_FROM=samgple <avisos@tu-dominio.com>
# LEAD_NOTIFY_EMAIL=tu@correo.com
# Alternativa a Resend: SMTP propio (también se puede guardar en Panel → Ajustes → Pagos y email)
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# ADMIN_EMAIL=tu@correo.com

# ===========================================
# Avisos por Telegram (solicitudes, llamadas, compras, bloqueos)
# ===========================================
# TELEGRAM_BOT_TOKEN=123456:ABC...      (de @BotFather)
# TELEGRAM_CHAT_ID=123456789            (tu chat: https://api.telegram.org/bot<TOKEN>/getUpdates)

# ===========================================
# Meta Pixel y API de conversiones
# ===========================================
# NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
# META_CAPI_TOKEN=...
# META_CAPI_TEST_CODE=TEST12345         (opcional, para la pestaña «Probar eventos»)

# ===========================================
# Seguridad
# ===========================================
# Tu usuario de Supabase (Authentication → Users → id): fija quién es el administrador.
# SITE_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
# IPs que nunca se bloquean, separadas por comas (además de las que se registran solas al entrar al panel).
# SECURITY_ALLOWLIST_IPS=203.0.113.7
